# Copy the values produced by scripts/gmail-auth.mjs into GitHub repo secrets.
# This file is only a reference — never commit real secrets.

# Google OAuth client (from Google Cloud Console -> APIs & Services -> Credentials)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Deployed Cloudflare Worker base URL, e.g. https://scholarship-email-tracker.<you>.workers.dev
WORKER_URL=

# Shared secret protecting POST /api/ingest (also set as Worker secret)
INGEST_SECRET=

# How many days back the sync looks for new mail
SYNC_LOOKBACK_DAYS=2
